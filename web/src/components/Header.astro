---
import { NAV, SITE } from '../data/site';

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';

const isActive = (href: string) => {
  if (href === '/') return path === '/';
  return path === href || path.startsWith(`${href}/`);
};
---

<header class="site-header">
  <div class="shell site-header__inner">
    <a href="/" class="brand" aria-label={`${SITE.name} 首页`}>
      <span class="brand__mark" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
      <span>mini-llm</span>
      <span class="brand__badge">{SITE.version}</span>
    </a>

    <nav class="site-nav" aria-label="主导航">
      {NAV.map((item) => (
        <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
          {item.label}
        </a>
      ))}
    </nav>

    <div class="site-header__actions">
      <button class="icon-btn" type="button" data-theme-toggle aria-label="切换深色模式">
        <svg class="theme-icon theme-icon--sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4.2"></circle>
          <path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.2 5.2l1.6 1.6M17.2 17.2l1.6 1.6M18.8 5.2l-1.6 1.6M6.8 17.2l-1.6 1.6"></path>
        </svg>
        <svg class="theme-icon theme-icon--moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M20.4 14.2A8.6 8.6 0 0 1 9.8 3.6a8.6 8.6 0 1 0 10.6 10.6Z"></path>
        </svg>
      </button>

      <a class="btn btn--primary" href="/learn">
        开始理解
        <span class="arrow" aria-hidden="true">→</span>
      </a>

      <details class="mobile-nav">
        <summary class="icon-btn" aria-label="打开导航">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
            <path d="M4 7h16M4 12h16M4 17h16"></path>
          </svg>
        </summary>
        <div class="mobile-nav__panel">
          {NAV.map((item) => (
            <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          ))}
          <a href="/docs/roadmap">路线图</a>
        </div>
      </details>
    </div>
  </div>
</header>
