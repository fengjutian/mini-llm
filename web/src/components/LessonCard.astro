---
import type { Lesson } from '../data/site';

interface Props {
  lesson: Lesson;
}

const { lesson } = Astro.props;
---

<a class="card lesson-card" href={lesson.href}>
  <div class="lesson-card__visual">
    {lesson.visual === 'tensor' && (
      <div class="mini-tensor" aria-hidden="true">
        {Array.from({ length: 12 }).map((_, i) => (
          <span class={i === 6 ? 'is-active' : ''} />
        ))}
      </div>
    )}
    {lesson.visual === 'softmax' && (
      <div class="mini-bars" aria-hidden="true">
        {[38, 62, 100, 26, 48].map((height, i) => (
          <span class={i === 2 ? 'is-active' : ''} style={`--h:${height}%`} />
        ))}
      </div>
    )}
    {lesson.visual === 'attention' && (
      <div class="mini-heat" aria-hidden="true">
        {[0.9, 0.2, 0.35, 0.1, 0.2, 0.8, 0.3, 0.15, 0.25, 0.3, 0.7, 0.2, 0.1, 0.2, 0.25, 0.85].map(
          (w) => <span style={`--w:${w}`} />,
        )}
      </div>
    )}
    {lesson.visual === 'autograd' && (
      <svg class="mini-graph" viewBox="0 0 152 92" aria-hidden="true">
        <path class="edge" d="M36 14 H58 C66 14 66 46 76 46" />
        <path class="edge" d="M36 46 H76" />
        <path class="edge" d="M36 78 H58 C66 78 66 46 76 46" />
        <path class="edge is-active" d="M96 46 H118" />
        <rect x="6" y="4" width="30" height="20" rx="3" />
        <rect x="6" y="36" width="30" height="20" rx="3" />
        <rect x="6" y="68" width="30" height="20" rx="3" />
        <circle cx="86" cy="46" r="10" />
        <circle class="is-active" cx="128" cy="46" r="10" />
      </svg>
    )}
    {lesson.visual === 'rope' && (
      <div class="mini-dials" aria-hidden="true">
        {[18, 64, 118, 156].map((angle, i) => (
          <span class={i === 1 ? 'is-active' : ''} style={`--a:${angle}deg`} />
        ))}
      </div>
    )}
    {lesson.visual === 'sampling' && (
      <div class="mini-strip" aria-hidden="true">
        {[34, 26, 17, 12, 7, 4].map((w, i) => (
          <span class={i === 1 ? 'is-active' : ''} style={`--w:${w}`} />
        ))}
      </div>
    )}
    {lesson.visual === 'loss' && (
      <svg class="mini-loss" viewBox="0 0 152 92" aria-hidden="true">
        <path class="axis" d="M12 8 V78 H144" />
        <polyline class="curve" points="16,20 30,38 44,52 58,43 72,57 86,61 100,64 114,66 128,67" />
        <circle cx="128" cy="67" r="3.5" />
      </svg>
    )}
    {lesson.visual === 'cache' && (
      <div class="mini-cache" aria-hidden="true">
        {[0, 1, 2, 3, 4, 5, 6, 7].map((i) => (
          <span class:list={{ 'is-filled': i < 6, 'is-active': i === 5 }} />
        ))}
      </div>
    )}
    {lesson.visual === 'mask' && (
      <div class="mini-mask" aria-hidden="true">
        {Array.from({ length: 36 }).map((_, i) => {
          const row = Math.floor(i / 6);
          const column = i % 6;
          return (
            <span
              class:list={{ 'is-masked': column > row, 'is-active': column === row }}
              style={`--w:${0.2 + ((row * 2 + column) % 5) * 0.12}`}
            />
          );
        })}
      </div>
    )}
  </div>
  <div class="lesson-card__body">
    <span class="lesson-card__tag">
      {lesson.index} · {lesson.tag} · {lesson.time}
    </span>
    <h3 class="lesson-card__title">{lesson.title}</h3>
    <p class="lesson-card__text">{lesson.summary}</p>
    <span class="lesson-card__link">
      进入实验 <span class="arrow" aria-hidden="true">→</span>
    </span>
  </div>
</a>
