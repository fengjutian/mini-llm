---
import 'katex/dist/katex.min.css';
import { getCollection } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import DocsSidebar from '../components/DocsSidebar.astro';
import Toc from '../components/Toc.astro';

interface Props {
  title: string;
  description: string;
  section: string;
  series?: string;
  part?: number;
  minutes: number;
  source: string;
  current: string;
  concepts?: string[];
  headings?: { depth: number; slug: string; text: string }[];
}

const {
  title,
  description,
  section,
  series,
  part,
  minutes,
  source,
  current,
  concepts = [],
  headings = [],
} = Astro.props;

const entries = (await getCollection('docs')).sort((a, b) => a.data.order - b.data.order);

// The generated documents mix two outline styles: some use H1 for chapters,
// others use H1 only for the title. Figure captions are also written as H2s.
// Keep the table of contents to numbered sections and recognised closers.
const numberedPattern =
  /^([一二三四五六七八九十百]+、|\d+(\.\d+)*[\s、.]|第[一二三四五六七八九十百\d]+[章部]|Milestone\s|V\d+[：:]|Step\s\d)/;
const closingPattern = /^(结语|小结|本章小结|总结|参考资料|附录|Definition of Done|后记)/;
const isStructural = (text: string) => numberedPattern.test(text.trim()) || closingPattern.test(text.trim());
const isContentHeading = (text: string) => /[^\d\s.、,，()（）]/.test(text);

const proseHeadings = headings.filter(
  (heading) => (heading.depth === 2 || heading.depth === 3) && isContentHeading(heading.text),
);
const structural = proseHeadings.filter((heading) => isStructural(heading.text));
const usable = structural.length >= 4 ? structural : proseHeadings;
const levelTwo = usable.filter((heading) => heading.depth === 2);
const levelOne = headings.filter(
  (heading) => heading.depth === 1 && isContentHeading(heading.text) && isStructural(heading.text),
);
// The table of contents is pinned beside the article and never scrolls, so it
// has to fit one viewport. Long documents step down to a coarser outline
// instead of growing a list that would be cut off.
const maxTocEntries = 18;
let tocHeadings = usable;
if (usable.length > maxTocEntries && levelTwo.length > 0) {
  tocHeadings = levelTwo.length <= maxTocEntries || levelOne.length < 3 ? levelTwo : levelOne;
}
const partLabel = part ? `第 ${String(part).padStart(2, '0')} 部分` : null;
---

<BaseLayout title={title} description={description} type="article" bodyClass="page-docs">
  <div class="reading-progress" data-reading-progress aria-hidden="true"></div>
  <div class="shell docs">
    <details class="docs__sidebar" open data-doc-nav>
      <summary class="docs__nav-summary">文档导航</summary>
      <DocsSidebar entries={entries} current={current} />
    </details>

    <div class="docs__main" data-docs-scroll>
      <header class="doc-head">
        <div class="doc-head__kicker">
          <span>{series ?? section}{partLabel ? ` · ${partLabel}` : ''}</span>
          <span class="sep" aria-hidden="true">/</span>
          <span>{source}</span>
          <span class="doc-head__spacer"></span>
          <span>约 {minutes} 分钟</span>
        </div>
        <h1>{title}</h1>
        <p class="doc-head__desc">{description}</p>
        {concepts.length > 0 && (
          <div class="doc-head__knowledge">
            <span class="doc-head__knowledge-label">知识点</span>
            <ul class="doc-head__concepts">
              {concepts.slice(0, 5).map((concept) => <li>{concept}</li>)}
            </ul>
          </div>
        )}
      </header>

      <article class="prose" data-article>
        <slot />
      </article>

      <footer class="doc-foot">
        <div class="doc-foot__meta">
          <span>来源 · {source}</span>
          <span>随仓库文档同步</span>
        </div>
        <slot name="pager" />
      </footer>
    </div>

    <aside class="docs__toc">
      {tocHeadings.length > 0 && <Toc headings={tocHeadings} />}
    </aside>
  </div>
</BaseLayout>

<script>
  const toc = document.querySelector<HTMLElement>('[data-toc]');
  const article = document.querySelector<HTMLElement>('[data-article]');
  // On wide screens the article column is its own scroll container (`body.page-docs`);
  // on narrow screens the document itself scrolls.
  const scroller = document.querySelector<HTMLElement>('[data-docs-scroll]');

  if (toc && article) {
    const progress = document.querySelector<HTMLElement>('[data-reading-progress]');
    const links = new Map<string, HTMLAnchorElement>();
    toc.querySelectorAll<HTMLAnchorElement>('a').forEach((link) => {
      const id = decodeURIComponent(link.hash.slice(1));
      if (id) links.set(id, link);
    });

    const headings = [...article.querySelectorAll<HTMLElement>('h1[id], h2[id], h3[id]')];
    // The outline can be chapter-level (H1) for long documents, so every
    // heading that owns a table-of-contents link can become the active entry.
    const linkedHeadings = headings.filter((heading) => links.has(heading.id));

    // Make section headings linkable: append a small anchor that appears on hover.
    headings.forEach((heading) => {
      const anchor = document.createElement('a');
      anchor.className = 'heading-anchor';
      anchor.href = `#${heading.id}`;
      anchor.setAttribute('aria-label', `链接到「${heading.textContent?.trim() ?? '本节'}」`);
      anchor.textContent = '#';
      heading.append(anchor);
    });

    let ticking = false;

    const update = () => {
      ticking = false;
      if (headings.length === 0) return;

      // Headings are compared against the top edge of whichever box scrolls.
      const viewportTop = scroller ? scroller.getBoundingClientRect().top : 0;
      const offset = viewportTop + 28;
      let activeId = linkedHeadings[0]?.id ?? headings[0].id;

      for (const heading of linkedHeadings) {
        if (heading.getBoundingClientRect().top <= offset) {
          activeId = heading.id;
        } else {
          break;
        }
      }

      // Near the end of the content, highlight the last heading.
      const atEnd = scroller
        ? scroller.scrollTop + scroller.clientHeight >= scroller.scrollHeight - 4
        : window.innerHeight + window.scrollY >= document.body.offsetHeight - 40;
      if (atEnd && linkedHeadings.length > 0) activeId = linkedHeadings[linkedHeadings.length - 1].id;

      links.forEach((link, id) => link.classList.toggle('is-active', id === activeId));

      if (progress) {
        if (scroller) {
          const distance = scroller.scrollHeight - scroller.clientHeight;
          const ratio = distance > 0 ? scroller.scrollTop / distance : 0;
          progress.style.width = `${Math.min(Math.max(ratio, 0), 1) * 100}%`;
        } else {
          const rect = article.getBoundingClientRect();
          const distance = rect.height - window.innerHeight;
          const scrolled = Math.min(Math.max(-rect.top, 0), Math.max(distance, 1));
          progress.style.width = distance > 0 ? `${(scrolled / distance) * 100}%` : '0%';
        }
      }
    };

    const requestUpdate = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(update);
    };

    if (scroller) {
      scroller.addEventListener('scroll', requestUpdate, { passive: true });
    } else {
      window.addEventListener('scroll', requestUpdate, { passive: true });
    }
    window.addEventListener('resize', requestUpdate);
    update();
  }
</script>
