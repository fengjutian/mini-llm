    background:
      radial-gradient(circle at 1px 1px, var(--dot) 1px, transparent 0) 0 0 / 16px 16px,
      var(--paper-3);
  }

  .matrix {
    display: grid;
    gap: 4px;
    justify-content: start;
  }

  .matrix :global(button) {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 40px;
    padding: 4px;
    border: 1px solid transparent;
    border-radius: 4px;
    background: var(--paper-2);
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--ink-soft);
    cursor: crosshair;
    transition: transform 0.1s var(--ease), border-color 0.1s var(--ease),
      background-color 0.1s var(--ease), color 0.1s var(--ease);
  }

  .matrix-caption {
    margin: 10px 0 0;
    font-size: 12px;
    line-height: 1.65;
    color: var(--ink-faint);
  }

  .slice-nav :global(select) {
    width: 70px;
    padding: 6px 8px;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: var(--paper);
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: 12px;
  }

  .matrix :global(button:hover),
  .matrix :global(button:focus-visible) {
    border-color: var(--accent);
    color: var(--ink);
    transform: translateY(-1px);
    outline: none;
  }

  .hover-readout {
    margin: 14px 0 0;
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--ink-soft);
    min-height: 1.6em;
  }

  .hover-readout.is-error {
    color: var(--accent-ink);
  }

  .table-wrap {
    margin: 1.5em 0;
    overflow-x: auto;
  }

  .table-wrap table {
    margin: 0;
  }

  .code-card {
    margin: 1.4em 0;
    border: 1px solid #262e34;
    border-radius: var(--radius-md);
    background: #0d1114;
    overflow: hidden;
  }

  .code-card__head {
    padding: 10px 16px;
    border-bottom: 1px solid #1e262c;
    background: #11171b;
    font-size: 10.5px;
    color: #7c878f;
    letter-spacing: 0.03em;
  }

  .code-card :global(pre) {
    margin: 0;
    padding: 16px 18px;
    background: #0d1114;
    font-size: 12.2px;
    line-height: 1.75;
    overflow-x: auto;
  }
</style>

<script>
  type Shape = number[];

  const widget = document.querySelector<HTMLElement>('[data-tensor-widget]');
  if (widget) {
    const input = widget.querySelector<HTMLInputElement>('[data-shape-input]')!;
    const presets = [...widget.querySelectorAll<HTMLButtonElement>('[data-shape]')];
    const matrix = widget.querySelector<HTMLElement>('[data-matrix]')!;
    const sliceNav = widget.querySelector<HTMLElement>('[data-slice-nav]')!;
    const hover = widget.querySelector<HTMLElement>('[data-hover]')!;
    const outRank = widget.querySelector<HTMLElement>('[data-out-rank]')!;
    const outSize = widget.querySelector<HTMLElement>('[data-out-size]')!;
    const outStrides = widget.querySelector<HTMLElement>('[data-out-strides]')!;
    const outBytes = widget.querySelector<HTMLElement>('[data-out-bytes]')!;

    const MAX_RANK = 6;
    const MAX_ELEMENTS = 4096;

    const computeStrides = (shape: Shape) => {
      const strides = new Array(shape.length).fill(1);
      for (let i = shape.length - 2; i >= 0; i -= 1) {
        strides[i] = strides[i + 1] * shape[i + 1];
      }
      return strides;
    };

    const parseShape = (raw: string): Shape | null => {
      const parts = raw
        .replace(/[[\]]/g, '')
        .split(/[\s,×x]+/)
        .filter(Boolean);

      if (parts.length === 0 || parts.length > MAX_RANK) return null;
      const shape: number[] = [];
      for (const part of parts) {
        if (!/^\d+$/.test(part)) return null;
        const value = Number(part);
        if (value < 1) return null;
        shape.push(value);
      }

      const size = shape.reduce((acc, dim) => acc * dim, 1);
      if (size > MAX_ELEMENTS) return null;
      return shape;
    };

    const leading = new Map<number, number>();

    const render = () => {
      const shape = parseShape(input.value);
      if (!shape) {
        hover.textContent = '形状无效：请用逗号分隔 1–6 个正整数，元素总数不超过 4096。';
        hover.classList.add('is-error');
        return;
      }
      hover.classList.remove('is-error');

      const strides = computeStrides(shape);
      const size = shape.reduce((acc, dim) => acc * dim, 1);
      outRank.textContent = String(shape.length);
      outSize.textContent = String(size);
      outStrides.textContent = strides.join(', ');
      outBytes.textContent = `${size * 4} B`;

      presets.forEach((button) => {
        button.setAttribute('aria-pressed', button.dataset.shape === shape.join(',') ? 'true' : 'false');
      });

      const outerDims = shape.slice(0, Math.max(0, shape.length - 2));
      const rows = shape.length >= 2 ? shape[shape.length - 2] : shape[0] ?? 1;
      const cols = shape.length >= 2 ? shape[shape.length - 1] : 1;

      sliceNav.innerHTML = '';
      sliceNav.hidden = outerDims.length === 0;
      outerDims.forEach((dim, dimIndex) => {
        if (!leading.has(dimIndex) || leading.get(dimIndex)! >= dim) {
          leading.set(dimIndex, 0);
        }
        const label = document.createElement('label');
        label.textContent = `dim ${dimIndex} · 长度 ${dim}`;
        const select = document.createElement('select');
        for (let value = 0; value < dim; value += 1) {
          const option = document.createElement('option');
          option.value = String(value);
          option.textContent = String(value);
          select.append(option);
        }
        select.value = String(leading.get(dimIndex));
        select.addEventListener('change', () => {
          leading.set(dimIndex, Number(select.value));
          render();
        });
        label.append(select);
        sliceNav.append(label);
      });

      const leadingIndices = outerDims.map((_, index) => leading.get(index) ?? 0);
      const baseOffset = leadingIndices.reduce((acc, value, index) => acc + value * strides[index], 0);

      const isVector = shape.length === 1;
      const rowCount = isVector ? shape[0] : rows;
      const colCount = isVector ? 1 : cols;
      const rowStride = shape.length >= 2 ? strides[strides.length - 2] : strides[0];
      const colStride = shape.length >= 2 ? strides[strides.length - 1] : 1;

      matrix.setAttribute('aria-rowcount', String(rowCount));
      matrix.setAttribute('aria-colcount', String(colCount));
      matrix.style.gridTemplateColumns = `repeat(${colCount}, minmax(0, 76px))`;
      matrix.innerHTML = '';

      for (let row = 0; row < rowCount; row += 1) {
        for (let col = 0; col < colCount; col += 1) {
          const indices = isVector ? [...leadingIndices, row] : [...leadingIndices, row, col];
          const offset = baseOffset + row * rowStride + col * colStride;

          const cell = document.createElement('button');
          cell.type = 'button';
          cell.textContent = String(offset);
          const tint = Math.round(4 + (offset / Math.max(1, size - 1)) * 28);
          cell.style.background = `color-mix(in srgb, var(--accent) ${tint}%, var(--paper-2))`;
          cell.setAttribute('aria-label', `索引 ${JSON.stringify(indices)}，偏移 ${offset}`);
          cell.addEventListener('mouseenter', () => showOffset(indices, strides, offset));
          cell.addEventListener('focus', () => showOffset(indices, strides, offset));
          matrix.append(cell);
        }
      }

      const initialIndices = isVector ? [0] : [...leadingIndices, 0, 0];
      showOffset(initialIndices, strides, baseOffset);
    };

    const showOffset = (indices: number[], strides: number[], offset: number) => {
      const terms = indices.map((value, index) => `${value}·${strides[index]}`);
      hover.textContent = `索引 [${indices.join(', ')}] → offset ${offset}  (${terms.join(' + ')})`;
    };

    input.addEventListener('input', render);
    presets.forEach((button) => {
      button.addEventListener('click', () => {
        input.value = button.dataset.shape ?? '';
        render();
      });
    });

    render();
  }
</script>
