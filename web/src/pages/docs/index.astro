---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import DocsSidebar from '../../components/DocsSidebar.astro';
import { DOC_TRACKS } from '../../data/site';

const entries = (await getCollection('docs')).sort((a, b) => a.data.order - b.data.order);

const groups = new Map<string, typeof entries>();
for (const entry of entries) {
  if (!groups.has(entry.data.section)) groups.set(entry.data.section, []);
  groups.get(entry.data.section)!.push(entry);
}

const trackBySection = new Map(DOC_TRACKS.map((track) => [track.section, track]));
const anchorFor = (section: string) =>
  trackBySection.get(section)?.anchor ??
  `track-${section.replace(/[^\p{Letter}\p{Number}]+/gu, '-').toLowerCase()}`;

const sections = [...groups.entries()]
  .map(([section, items]) => ({
    section,
    items,
    anchor: anchorFor(section),
    blurb: trackBySection.get(section)?.blurb ?? '仓库中尚未归入主线的文档。',
    minutes: items.reduce((sum, entry) => sum + entry.data.minutes, 0),
  }))
  .sort((a, b) => a.items[0].data.order - b.items[0].data.order);

const totalMinutes = entries.reduce((sum, entry) => sum + entry.data.minutes, 0);
const knowledgeSections = sections.filter(
  (group) => group.section !== '项目设计' && group.section !== '扩展阅读',
);
const humanDuration = (minutes: number) =>
  minutes < 60 ? `约 ${minutes} 分钟` : `约 ${(minutes / 60).toFixed(1).replace(/\.0$/, '')} 小时`;
const pad = (value: number) => String(value).padStart(2, '0');
---

<BaseLayout
  title="知识地图"
  description="mini-llm 的知识地图：从数学、Tensor、Transformer 到训练与评估，再到认知、记忆、因果、规划、决策与智能体。"
>
  <div class="shell docs docs--index">
    <details class="docs__sidebar" open data-doc-nav>
      <summary class="docs__nav-summary">文档导航</summary>
      <DocsSidebar entries={entries} />
    </details>

    <div>
      <header class="doc-head">
        <div class="doc-head__kicker">
          <span>知识地图</span>
          <span class="sep" aria-hidden="true">/</span>
          <span>docs/</span>
          <span class="doc-head__spacer"></span>
          <span>{entries.length} 篇</span>
        </div>
        <h1>从实现，到会行动的智能体</h1>
        <p class="doc-head__desc">
          文档按 {knowledgeSections.length} 条知识主线组织：先实现一个能训练的小模型，再往上讨论表征、记忆、
          知识与因果，最后是规划、决策、学习和 Agent。每张卡片标出了部分编号、阅读时长与核心知识点，
          下面的搜索框可以直接过滤知识点。
        </p>
      </header>

      <div class="docs-tools">
        <label class="docs-search">
          <span class="visually-hidden">搜索文档或知识点</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
            <circle cx="11" cy="11" r="6.5"></circle>
            <path d="m16 16 4 4"></path>
          </svg>
          <input type="search" placeholder="搜索文档或知识点…" data-docs-search />
        </label>
        <span class="docs-tools__meta">
          <strong>{humanDuration(totalMinutes)}</strong> · {knowledgeSections.length} 条主线
        </span>
      </div>

      <div class="tracks">
        {sections.map((group) => (
          <section class="track" id={group.anchor} data-doc-section>
            <header class="track__head">
              <div>
                <h2>{group.section}</h2>
                <p>{group.blurb}</p>
              </div>
              <span class="track__meta">
                {group.items.length} 篇 · {humanDuration(group.minutes)}
              </span>
            </header>

            <div class="docs-cards">
              {group.items.map((entry) => (
                <a
                  class="doc-tile"
                  href={`/docs/${entry.id}`}
                  data-doc-card
                  data-search={`${entry.data.title} ${entry.data.description} ${(entry.data.concepts ?? []).join(' ')} ${entry.data.short ?? ''}`}
                >
                  <div class="doc-tile__top">
                    {entry.data.part ? (
                      <span class="doc-tile__part">Part {pad(entry.data.part)}</span>
                    ) : (
                      <span class="doc-tile__part doc-tile__part--plain">文档</span>
                    )}
                    <span class="doc-tile__meta">
                      {entry.data.minutes} 分钟
                      <span aria-hidden="true">·</span>
                      {entry.data.source.replace('docs/', '')}
                    </span>
                  </div>

                  <h3>{entry.data.title}</h3>
                  <p>{entry.data.description}</p>

                  {(entry.data.concepts ?? []).length > 0 && (
                    <ul class="concepts" aria-label="知识点">
                      {entry.data.concepts.slice(0, 3).map((concept) => (
                        <li>{concept}</li>
                      ))}
                    </ul>
                  )}

                  <span class="doc-tile__more">
                    阅读 <span class="arrow" aria-hidden="true">→</span>
                  </span>
                </a>
              ))}
            </div>
          </section>
        ))}
      </div>

      <p class="docs-empty" data-search-empty hidden>没有匹配的文档。试试更短的关键词，例如「注意力」「记忆」。</p>

      <div class="note docs-note">
        <strong>同步方式</strong>
        文档由 <code>web/scripts/sync-docs.mjs</code> 在 <code>dev</code> / <code>build</code> 前生成：自动发现
        <code>docs/*.md</code>，识别所属主线与编号，提取知识点，补上阅读时长，并把
        <code>\[ ... \]</code> 公式归一化为 LaTeX。新增文档不需要改页面代码。
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .docs.docs--index {
    grid-template-columns: 216px minmax(0, 1fr);
  }

  /* Search ----------------------------------------------------------------- */

  .docs-tools {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin: 22px 0 8px;
  }

  .docs-search {
    display: flex;
    align-items: center;
    gap: 9px;
    flex: 1;
    min-width: 240px;
    max-width: 520px;
    padding: 9px 13px;
    border: 1px solid var(--line);
    border-radius: 9px;
    background: var(--paper-2);
    transition: border-color 0.15s var(--ease), box-shadow 0.15s var(--ease);
  }

  .docs-search:focus-within {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-wash);
  }

  .docs-search svg {
    width: 15px;
    height: 15px;
    flex: none;
    color: var(--ink-faint);
  }

  .docs-search input {
    width: 100%;
    border: 0;
    background: transparent;
    color: var(--ink);
    font-family: var(--font-sans);
    font-size: 13.5px;
    outline: none;
  }

  .docs-search input::placeholder {
    color: var(--ink-faint);
  }

  .docs-tools__meta {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.02em;
    color: var(--ink-faint);
  }

  .docs-tools__meta strong {
    color: var(--ink);
    font-weight: 600;
  }

  /* Tracks ----------------------------------------------------------------- */

  .tracks {
    display: grid;
    gap: 44px;
    margin-top: 26px;
  }

  .track {
    scroll-margin-top: calc(var(--header-h) + 24px);
  }

  .track[hidden] {
    display: none;
  }

  .track__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 10px 20px;
    margin-bottom: 16px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--line);
  }

  .track__head h2 {
    margin: 0;
    font-size: 22px;
    font-weight: 640;
    letter-spacing: -0.02em;
  }

  .track__head p {
    margin: 6px 0 0;
    max-width: 60ch;
    font-size: 13px;
    line-height: 1.65;
    color: var(--ink-soft);
  }

  .track__meta {
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: var(--ink-faint);
    white-space: nowrap;
  }

  /* Cards ------------------------------------------------------------------ */

  .docs-cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
  }

  .doc-tile {
    display: flex;
    flex-direction: column;
    gap: 9px;
    padding: 20px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--paper-2);
    transition: border-color 0.16s var(--ease), transform 0.16s var(--ease),
      box-shadow 0.16s var(--ease);
  }

  .doc-tile[hidden] {
    display: none;
  }

  .doc-tile:hover {
    border-color: var(--line-strong);
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }

  .doc-tile__top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }

  .doc-tile__part {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .doc-tile__part--plain {
    color: var(--ink-faint);
  }

  .doc-tile__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: var(--ink-faint);
    letter-spacing: 0.02em;
  }

  .doc-tile h3 {
    margin: 0;
    font-size: 17px;
    font-weight: 620;
    letter-spacing: -0.015em;
  }

  .doc-tile p {
    margin: 0;
    font-size: 13.5px;
    line-height: 1.7;
    color: var(--ink-soft);
  }

  .concepts {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .concepts li {
    padding: 3px 7px;
    border: 1px solid var(--line);
    border-radius: 4px;
    background: var(--paper);
    font-family: var(--font-mono);
    font-size: 10px;
    line-height: 1.5;
    color: var(--ink-faint);
  }

  .doc-tile:hover .concepts li {
    border-color: var(--line-strong);
    color: var(--ink-soft);
  }

  .doc-tile__more {
    margin-top: auto;
    padding-top: 4px;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--accent-ink);
  }

  .doc-tile:hover .arrow {
    display: inline-block;
    transform: translateX(3px);
  }

  .docs-empty {
    margin: 30px 0;
    font-size: 14px;
    color: var(--ink-faint);
  }

  .docs-note {
    margin-top: 40px;
  }

  @media (max-width: 1120px) {
    .docs.docs--index {
      grid-template-columns: 196px minmax(0, 1fr);
    }
  }

  @media (max-width: 900px) {
    .docs.docs--index {
      display: block;
    }
  }

  @media (max-width: 720px) {
    .docs-cards {
      grid-template-columns: minmax(0, 1fr);
    }

    .track__head {
      align-items: flex-start;
    }
  }
</style>

<script>
  const input = document.querySelector<HTMLInputElement>('[data-docs-search]');
  const empty = document.querySelector<HTMLElement>('[data-search-empty]');
  const cards = [...document.querySelectorAll<HTMLElement>('[data-doc-card]')];
  const sections = [...document.querySelectorAll<HTMLElement>('[data-doc-section]')];

  if (input) {
    const apply = () => {
      const query = input.value.trim().toLowerCase();
      let matches = 0;

      cards.forEach((card) => {
        const hit = query.length === 0 || (card.dataset.search ?? '').toLowerCase().includes(query);
        card.hidden = !hit;
        if (hit) matches += 1;
      });

      sections.forEach((section) => {
        section.hidden = ![...section.querySelectorAll<HTMLElement>('[data-doc-card]')].some(
          (card) => !card.hidden,
        );
      });

      if (empty) empty.hidden = matches > 0;
    };

    input.addEventListener('input', apply);
    input.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        input.value = '';
        apply();
        input.blur();
      }
    });
  }
</script>
