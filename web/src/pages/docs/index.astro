---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import DocsSidebar from '../../components/DocsSidebar.astro';

const entries = (await getCollection('docs')).sort((a, b) => a.data.order - b.data.order);
const engine = entries.filter((entry) => entry.data.part);
const design = entries.filter((entry) => !entry.data.part);
const seriesTitle = engine[0]?.data.series ?? '引擎系列';
const totalMinutes = engine.reduce((sum, entry) => sum + entry.data.minutes, 0);
const pad = (value: number) => String(value).padStart(2, '0');
---

<BaseLayout
  title="文档"
  description="mini-llm 的引擎系列与项目文档：从数学基础、Tensor、Autograd、Transformer，到训练、评估、内部表征与世界模型。"
>
  <div class="shell docs docs--index">
    <details class="docs__sidebar" open data-doc-nav>
      <summary class="docs__nav-summary">文档导航</summary>
      <DocsSidebar entries={entries} />
    </details>

    <div>
      <header class="doc-head">
        <div class="doc-head__kicker">
          <span>仓库文档</span>
          <span class="sep" aria-hidden="true">/</span>
          <span>docs/</span>
          <span class="doc-head__spacer"></span>
          <span>{entries.length} 篇</span>
        </div>
        <h1>从内核到设计决策</h1>
        <p class="doc-head__desc">
          引擎系列是一条完整的实现路径：先补数学，再实现张量、自动微分、网络层、Transformer 与训练循环，
          最后讨论评估、内部表征与世界模型。每一页都直接来自仓库的 <code>docs/*.md</code>，与代码一起演进。
        </p>
      </header>

      <section class="series-band" aria-labelledby="series-title">
        <div class="series-band__head">
          <div>
            <h2 id="series-title">{seriesTitle}</h2>
            <p>
              {engine.length} 个部分 · 约 {Math.round(totalMinutes / 60)} 小时阅读 · 从数学到世界模型
            </p>
          </div>
          <a class="series-band__start" href={`/docs/${engine[0]?.id}`}>
            从第一部分开始 <span class="arrow" aria-hidden="true">→</span>
          </a>
        </div>

        <ol class="series-path">
          {engine.map((entry) => (
            <li>
              <a href={`/docs/${entry.id}`}>
                <span class="series-path__num">{pad(entry.data.part ?? 0)}</span>
                <span class="series-path__title">{entry.data.short ?? entry.data.title}</span>
              </a>
            </li>
          ))}
        </ol>
      </section>

      <div class="docs-cards docs-cards--engine">
        {engine.map((entry) => (
          <a class="doc-tile doc-tile--part" href={`/docs/${entry.id}`}>
            <div class="doc-tile__top">
              <span class="doc-tile__part">Part {pad(entry.data.part ?? 0)}</span>
              <span class="doc-tile__meta">
                {entry.data.minutes} 分钟
                <span aria-hidden="true">·</span>
                {entry.data.source.replace('docs/', '')}
              </span>
            </div>
            <h3>{entry.data.title}</h3>
            <p>{entry.data.description}</p>
            <span class="doc-tile__more">
              阅读 <span class="arrow" aria-hidden="true">→</span>
            </span>
          </a>
        ))}
      </div>

      <section class="docs-group docs-group--design">
        <h2 class="docs-group__label">项目设计</h2>
        <div class="docs-cards">
          {design.map((entry) => (
            <a class="doc-tile" href={`/docs/${entry.id}`}>
              <span class="doc-tile__meta">
                {entry.data.source.replace('docs/', '')}
                <span aria-hidden="true">·</span>
                {entry.data.minutes} 分钟
              </span>
              <h3>{entry.data.title}</h3>
              <p>{entry.data.description}</p>
              <span class="doc-tile__more">
                阅读 <span class="arrow" aria-hidden="true">→</span>
              </span>
            </a>
          ))}
        </div>
      </section>

      <div class="note docs-note">
        <strong>同步方式</strong>
        文档页由 <code>web/scripts/sync-docs.mjs</code> 在 <code>dev</code> / <code>build</code> 前生成：
        自动发现 <code>docs/*.md</code>、补上标题摘要与阅读时长、把 <code>\[ ... \]</code> 公式转换成标准
        LaTeX 分隔符，并去掉重复的一级标题。新增文档不用改页面代码。
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .docs.docs--index {
    grid-template-columns: 216px minmax(0, 1fr);
  }

  /* Series band ------------------------------------------------------------ */

  .series-band {
    margin-top: 30px;
    padding: 22px 24px 20px;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background:
      radial-gradient(circle at 1px 1px, var(--dot) 1px, transparent 0) 0 0 / 18px 18px,
      var(--paper-2);
  }

  .series-band__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 14px;
  }

  .series-band__head h2 {
    margin: 0;
    font-size: 15px;
    font-weight: 620;
    letter-spacing: -0.01em;
  }

  .series-band__head p {
    margin: 5px 0 0;
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.02em;
    color: var(--ink-faint);
  }

  .series-band__start {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--accent-ink);
  }

  .series-band__start .arrow {
    transition: transform 0.16s var(--ease);
  }

  .series-band__start:hover .arrow {
    transform: translateX(3px);
  }

  .series-path {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 0;
    margin: 18px 0 0;
    padding: 0;
    list-style: none;
  }

  .series-path li {
    display: flex;
    align-items: center;
  }

  .series-path li + li::before {
    content: "→";
    margin: 0 6px;
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--line-strong);
  }

  .series-path a {
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
    padding: 5px 9px;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: var(--paper);
    transition: border-color 0.14s var(--ease), color 0.14s var(--ease);
  }

  .series-path a:hover {
    border-color: var(--accent);
    color: var(--accent-ink);
  }

  .series-path__num {
    font-family: var(--font-mono);
    font-size: 9.5px;
    color: var(--accent);
  }

  .series-path__title {
    font-size: 12.5px;
    color: var(--ink-soft);
  }

  /* Cards ------------------------------------------------------------------ */

  .docs-cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
  }

  .docs-cards--engine {
    margin-top: 16px;
  }

  .doc-tile {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 20px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--paper-2);
    transition: border-color 0.16s var(--ease), transform 0.16s var(--ease),
      box-shadow 0.16s var(--ease);
  }

  .doc-tile:hover {
    border-color: var(--line-strong);
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }

  .doc-tile__top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }

  .doc-tile__part {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .doc-tile__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: var(--ink-faint);
    letter-spacing: 0.02em;
  }

  .doc-tile h3 {
    margin: 0;
    font-size: 17px;
    font-weight: 620;
    letter-spacing: -0.015em;
  }

  .doc-tile p {
    margin: 0;
    flex: 1;
    font-size: 13.5px;
    line-height: 1.7;
    color: var(--ink-soft);
  }

  .doc-tile__more {
    margin-top: 6px;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--accent-ink);
  }

  .doc-tile:hover .arrow {
    display: inline-block;
    transform: translateX(3px);
  }

  /* Design docs ------------------------------------------------------------ */

  .docs-group--design {
    margin-top: 40px;
  }

  .docs-group__label {
    margin: 0 0 12px;
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .docs-note {
    margin-top: 36px;
  }

  @media (max-width: 1120px) {
    .docs.docs--index {
      grid-template-columns: 196px minmax(0, 1fr);
    }
  }

  @media (max-width: 900px) {
    .docs.docs--index {
      display: block;
    }
  }

  @media (max-width: 720px) {
    .docs-cards {
      grid-template-columns: minmax(0, 1fr);
    }

    .series-path li + li::before {
      content: "";
      margin: 0;
    }

    .series-path {
      gap: 6px;
    }
  }
</style>
