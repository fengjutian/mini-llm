---
import { getCollection, render } from 'astro:content';
import DocsLayout from '../../layouts/DocsLayout.astro';

export async function getStaticPaths() {
  const docs = (await getCollection('docs')).sort((a, b) => a.data.order - b.data.order);

  return docs.map((entry, index) => ({
    params: { slug: entry.id },
    props: {
      entry,
      previous: docs[index - 1],
      next: docs[index + 1],
    },
  }));
}

const { entry, previous, next } = Astro.props;
const { Content, headings } = await render(entry);

const pagerLabel = (item: typeof entry | undefined, direction: 'previous' | 'next') => {
  if (!item) return '';
  const prefix = direction === 'previous' ? '← ' : '';
  const suffix = direction === 'next' ? ' →' : '';
  if (item.data.part) {
    return `${prefix}第 ${String(item.data.part).padStart(2, '0')} 部分${suffix}`;
  }
  return `${prefix}${direction === 'previous' ? '上一篇' : '下一篇'}${suffix}`;
};
---

<DocsLayout
  title={entry.data.title}
  description={entry.data.description}
  section={entry.data.section}
  series={entry.data.series}
  part={entry.data.part}
  minutes={entry.data.minutes}
  source={entry.data.source}
  current={entry.id}
  concepts={entry.data.concepts}
  headings={headings}
>
  <Content />

  <Fragment slot="pager">
    {(previous || next) && (
      <nav class="doc-pager" aria-label="文档翻页">
        {previous ? (
          <a href={`/docs/${previous.id}`}>
            <span>{pagerLabel(previous, 'previous')}</span>
            <strong>{previous.data.title}</strong>
          </a>
        ) : (
          <span></span>
        )}
        {next ? (
          <a href={`/docs/${next.id}`}>
            <span>{pagerLabel(next, 'next')}</span>
            <strong>{next.data.title}</strong>
          </a>
        ) : (
          <span></span>
        )}
      </nav>
    )}
  </Fragment>
</DocsLayout>
