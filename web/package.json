{
  "name": "mini-llm-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Astro site for mini-llm: concept lessons and repository docs.",
  "packageManager": "pnpm@11.28.5",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "sync": "node scripts/sync-docs.mjs",
    "sample": "node scripts/bundle-trace.mjs",
    "sample:auto": "node scripts/bundle-trace.mjs --optional",
    "dev": "pnpm run sync && pnpm run sample:auto && astro dev",
    "build": "pnpm run sync && pnpm run sample:auto && astro build",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.10",
    "@astrojs/react": "^7.1.9",
    "astro": "^7.4.13",
    "katex": "^0.16.22",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0"
  }
}
